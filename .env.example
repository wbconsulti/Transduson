# ---- Fonte de dados -------------------------------------------------------
# true  = lê fixtures/*.json (v1 demo, sem tocar em banco nenhum)
# false = conecta no HANA de verdade via hdbcli (requer as variáveis abaixo
#         e `pip install -r requirements-hana.txt`)
USE_FIXTURES=true

# ---- Conexão HANA (só usada quando USE_FIXTURES=false) --------------------
HANA_HOST=
HANA_PORT=30015
HANA_USER=
HANA_PASSWORD=
HANA_SCHEMA=SBO_TRANSDUSONPRD
HANA_ENCRYPT=true

# ---- Table functions confirmadas com o cliente (Resumo/Detalhe) -----------
# Pagar/Receber NÃO são configuráveis aqui - usam os scripts completos em
# sql/pagar_v12.sql e sql/receber_v1.sql (ver db.py).
HANA_TF_FLUXO_RESUMO=TF_FLUXO_CAIXA_RESUMIDO_DIARIO
HANA_TF_FLUXO_DETALHE=TF_FLUXO_CAIXA_DETALHADO_DIARIO

# Janela de datas padrão (dias) quando a API não recebe de/ate na querystring
HANA_DEFAULT_DIAS=30
